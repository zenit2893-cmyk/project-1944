# Explicitly select publishable roots. The content guard is still required.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.gitmodules
!/README.md
!/README.ru.md
!/README.uk.md
!/LICENSE
!/CONTRIBUTING.md
!/CODE_OF_CONDUCT.md
!/SECURITY.md
!/SUPPORT.md
!/OPEN-QUESTIONS.md
!/.github/
!/cod3-pc/
!/integration/
!/launcher/
!/scripts/
!/tests/
!/docs/
!/analysis/
!/tools/
!/licenses/

# Only safe analysis inputs may be published.
/analysis/*
!/analysis/disc-source-lock.json
!/analysis/disc-file-manifest.csv
!/analysis/cod3-allmodule-coroutine-sites.py
!/analysis/cod3-allmodule-coroutine-manifest.json
!/analysis/cod3-module-function-hints.py
!/analysis/cod3-module-pointer-sweep.py
!/analysis/cod3-pointer-sweep.py

# Tool sources are pinned submodules or small provisioning scripts.
/tools/*
!/tools/rexglue-cli/
!/tools/toolchain-provision/
!/tools/toolchain-bootstrap/
!/tools/xenon-bridge-build/
!/tools/signing/
!/tools/rexglue-source/
!/tools/XenonRecomp/
!/tools/XenosRecomp/
!/tools/Xenia-source/

# ReXGlue scaffold and partition metadata contain no generated game code.
/cod3-pc/generated/*
!/cod3-pc/generated/rexglue.cmake
!/cod3-pc/generated/*/
/cod3-pc/generated/*/*
!/cod3-pc/generated/*/codegen.partition.json

# Local data, generated code, outputs, and third-party staging copies.
/game/
/cod3/
/logs/
/win-amd64/
/README-FOR-CODEX.md
/Project1944.exe
**/.git/
**/.vs/
**/__pycache__/
**/node_modules/
**/out/
**/build/
**/cache/
**/userdata/
**/metadata/
**/staging/
**/artifacts/
**/downloads/
**/xenon-generated/
/integration/xenon/generated/
/integration/coroutines/generated/
/integration/coroutines/templates/codegen/
/integration/rexglue-runtime-build/src/
/integration/rexglue-runtime-build/probe-build/
/integration/upscaling/runtime-source/
/integration/upscaling/overlay/
/integration/vfetch-bounds/source/
/integration/rexglue-patches/candidate/
/integration/mp-target/
/docs/reports/*.json
/docs/reports/*/
/launcher/exe/icon-source.*
/launcher/exe/*.ico
/launcher/exe/bin/
*.iso
*.7z
*.zip
*.rar
*.xex
*.cod
*.wbk
*.wma
*.wmv
*.bik
*.xma
*.xpr
*.bin
*.dmp
*.xsh
*.xpso
*.dxil
*.spv
*.exe
*.dll
*.lib
*.obj
*.pdb
*.ico
