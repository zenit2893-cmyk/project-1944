+float2 textureGradientScaleCoD3(uint fetchWord4, float registerAndInstructionLod)
+{
+    int samplerBias = (int)(fetchWord4 << 10) >> 22;
+    int horizontalExponent = (int)(fetchWord4 << 5) >> 27;
+    int verticalExponent = (int)fetchWord4 >> 27;
