+// Inverse cube face projection from the shader's (SC, TC in 1..2, face ID).
+// Explicit register gradients already are in cube space and are NOT projected.
+float3 cubeDirectionCoD3(float3 coord)
+{
+    float2 st = coord.xy * 2.0 - 3.0;
+    uint face = min((uint)coord.z, 5u);
+    bool negative = (face & 1u) != 0;
+    switch (face >> 1)
+    {
+    case 0: return float3(negative ? -1.0 : 1.0, -st.y, negative ? st.x : -st.x);
+    case 1: return float3(st.x, negative ? -1.0 : 1.0, negative ? -st.y : st.y);
+    default: return float3(negative ? -st.x : st.x, -st.y, negative ? -1.0 : 1.0);
