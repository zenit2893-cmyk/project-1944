+// src is the decoded ALU source 0 (.zzxy for an ordinary cube instruction).
+// Return TC, SC, signed twice-major-axis and D3DCUBEMAP_FACES face ID.
+float4 cubeCoD3(float4 src)
+{
+    float3 v = src.zwx;
+    if (abs(v.z) >= abs(v.x) && abs(v.z) >= abs(v.y))
+        return float4(-v.y, v.z < 0.0 ? -v.x : v.x, 2.0 * v.z, v.z < 0.0 ? 5.0 : 4.0);
