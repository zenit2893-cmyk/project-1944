+bool XexModule::AllocateImageMemory(uint32_t size) {
+  if (image_memory_allocated_) {
+    REXLOG_ERROR("XEX module already owns an image reservation at {:08X}", base_address_);
+    return false;
+  }
+
+  auto* heap = memory()->LookupHeap(base_address_);
+  constexpr uint32_t protect =
+      rex::memory::kMemoryProtectRead | rex::memory::kMemoryProtectWrite;
+  // Reserve separately: the combined reserve+commit path permits already
+  // committed pages. A module must never overwrite another module or a native
+  // function table that happens to share its guest XEX heap.
+  if (!heap->AllocFixed(base_address_, size, 4096,
+                       rex::memory::kMemoryAllocationReserve, protect)) {
+    return false;
+  }
+  image_memory_allocated_ = true;
+  if (!heap->AllocFixed(base_address_, size, 4096,
+                       rex::memory::kMemoryAllocationCommit, protect)) {
+    ReleaseImageMemory();
+    return false;
+  }
+  return true;
+}
+
+bool XexModule::ReleaseImageMemory() {
+  if (!image_memory_allocated_) {
+    return true;
+  }
+  if (!memory()->LookupHeap(base_address_)->Release(base_address_)) {
+    REXLOG_ERROR("Failed to release XEX-owned image reservation at {:08X}", base_address_);
+    return false;
+  }
+  image_memory_allocated_ = false;
+  return true;
+}
